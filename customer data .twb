      <aliases enabled='yes' />
      <column caption='Churn flag' datatype='integer' name='[Calculation_0847860630204416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='churn rate %' datatype='real' name='[Calculation_0847860630405121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0847860630204416])' />
      </column>
      <column caption='Tenure band' datatype='string' name='[Calculation_0847860630732802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0–12 months&quot; ELSEIF [tenure] &lt;= 24 THEN &quot;13–24 months&quot; ELSEIF [tenure] &lt;= 48 THEN &quot;25–48 months&quot; ELSE &quot;49+ months&quot; END' />
      </column>
      <column caption='customer lifetime value' datatype='real' name='[Calculation_0847860631363587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MonthlyCharges]) * AVG([tenure])' />
      </column>
